# Copy to .env (or export in your shell) and adjust.

# Port the HTTP server listens on
PORT=3000

# Public base URL used inside QR codes and share links (no trailing slash)
BASE_URL=http://localhost:3000

# Secret key required on all /api/admin/* requests (X-Admin-Key header)
ADMIN_API_KEY=change-me

# Owner-level key for God Mode (/god dashboard and /api/god/*). Also accepted
# anywhere the admin key is. Keep this one especially secret.
GOD_MODE_KEY=god-change-me

# Refer-reminder cadence: nudge referrers with no referral and no reminder in
# this many days (POST /api/admin/nudges/run, or the God Mode button)
NUDGE_DAYS=14

# SQLite database file (created on first run). Use :memory: for throwaway runs.
DB_PATH=data/goldcard.db

# Optional: GoHighLevel private integration token + pipeline config.
# When unset, inquiries are still stored locally and the push is logged as skipped.
GHL_API_TOKEN=
GHL_LOCATION_ID=
