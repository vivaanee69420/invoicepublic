# Copy to .env for local dev, or set these in your host's dashboard.

# Owner login password — REQUIRED before exposing publicly.
# If unset, the app falls back to "changeme" and logs a warning.
OWNER_PASSWORD=change-this-to-a-strong-password

# Name shown on the board after you sign in.
OWNER_NAME=Dr. Gaurav

# Where the JSON database lives. Point at a persistent disk in production
# (e.g. a Render disk mounted at /var/data). Defaults to ./data locally.
DATA_DIR=./data

# Send the session cookie only over HTTPS. Auto-on when NODE_ENV=production;
# set to "true" if you terminate TLS in front of the app another way.
SECURE_COOKIES=true

# Port to listen on (host platforms usually set this for you).
PORT=3000
